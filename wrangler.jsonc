{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ipib-preview",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "SUPABASE_MEDIA_BUCKET": "ipib-media"
  }
}
